# otun-realm-agent 环境变量（install.sh 通过 systemd Environment= 注入）
# 六协议总设计：SIX_PROTOCOL_IMPLEMENTATION_DESIGN.md

# —— 身份（必填）——
NODE_API_KEY=rk_live_xxxxxxxx
NODE_ID=realm-cn-sh-01

# —— 首启引导（realm token/stun/obfs/ss_method/reality 密钥/sni/dns/protocols 由 manager 下发，不在此设置）——
# REALM_ID 是 base；各协议派生 <base>-<proto> 注册会合面（如 iptv-cn-sh-hy2 / -reality ...）。
REALM_ID=iptv-cn-sh
REALM_REGION=cn-sh-mobile

# —— manager 接入 ——
OTUN_API_URL=https://otun-manager-v3.situstechnologies.com
# ★Batch 5：fleet-manager 地址（纳管 register/heartbeat 直连 fleet）。
# 留空 → agent 回退用 OTUN_API_URL（不配 fleet = 旧行为，register/heartbeat 仍打 otun，零回归）。
FLEET_API_URL=
MANAGEMENT_MODE=remote

# —— 本地监听 ——
# ★六协议本地 UDP 端口是 agent 内部约定常量（hy2=51820 tuic=51821 reality=51822
#   trojan=51823 ss=51824 vmess=51825），不从 env 传、不对外、不进 manager。

# —— 周期（秒）——
SYNC_INTERVAL=60
STATS_INTERVAL=60
REALM_INTERVAL=45

# —— 运营平面（§7.3.2，私网采集端点；留空则 no-op 模式）——
OBS_ENDPOINT=
