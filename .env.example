# otun-realm-agent 环境变量（install.sh 通过 systemd Environment= 注入）
# 见 OTUN_REALM_AGENT_DESIGN.md §7.7.1

# —— 身份（必填）——
NODE_API_KEY=rk_live_xxxxxxxx
NODE_ID=realm-cn-sh-01

# —— 首启引导（realm_token/stun/obfs/sni/dns 由 manager 下发，不在此设置）——
REALM_ID=iptv-cn-sh
REALM_SERVER_URL=https://situstechnologies.com/realm
REALM_REGION=cn-sh-mobile

# —— manager 接入 ——
OTUN_API_URL=https://otun-manager-v3.situstechnologies.com
MANAGEMENT_MODE=remote

# —— 本地监听 ——
HY2_PORT=51820

# —— sing-box ——
SINGBOX_BIN=/usr/local/bin/sing-box
SINGBOX_CONFIG=/etc/sing-box/config.json

# —— 周期（秒）——
SYNC_INTERVAL=60
STATS_INTERVAL=60
REALM_INTERVAL=45

# —— 运营平面（§7.3.2，私网采集端点；留空则 no-op 模式）——
OBS_ENDPOINT=
